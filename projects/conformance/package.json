{
  "name": "@algorandfoundation/arc87",
  "version": "0.0.0",
  "type": "module",
  "description": "Reference implementation of ARC-87: Key Name Specification (vectors and TypeScript library)",
  "license": "CC0-1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/algorandfoundation/arc-87-reference",
    "directory": "projects/conformance"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./vectors/*": "./vectors/*"
  },
  "files": [
    "lib",
    "vectors",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rm -rf ./lib",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@algorandfoundation/algokit-utils": "^9.1.1",
    "lodash.get": "^4.4.2",
    "lodash.set": "^4.3.2"
  },
  "devDependencies": {
    "@types/lodash.get": "^4.4.9",
    "@types/lodash.set": "^4.3.9",
    "@types/node": "^24.0.14",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
