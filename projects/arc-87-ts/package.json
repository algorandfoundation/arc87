{
  "name": "arc-87-ts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "ARC-87 reference contract written in Algorand TypeScript (puya-ts), with typed client, demo and tests",
  "license": "CC0-1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/algorandfoundation/arc-87-reference",
    "directory": "projects/arc-87-ts"
  },
  "scripts": {
    "clean": "rm -rf ./smart_contracts/artifacts ./smart_contracts/client.ts ./smart_contracts/arc87-reader.client.ts",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "build:compile": "puya-ts smart_contracts/arc87.algo.ts smart_contracts/arc87-reader.algo.ts --out-dir artifacts --output-arc56 --no-output-arc32 --output-source-map --target-avm-version 13",
    "build:generate": "algokit generate client -l typescript -o ./smart_contracts/client.ts ./smart_contracts/artifacts/ARC87.arc56.json && algokit generate client -l typescript -o ./smart_contracts/arc87-reader.client.ts ./smart_contracts/artifacts/ARC87Reader.arc56.json",
    "build": "npm run build:compile && npm run build:generate && npm run typecheck",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run -c vitest.integration.config.mts",
    "demo": "tsx ./examples/demo.ts",
    "audit:prepare": "tsx ./scripts/substitute-template-vars.ts"
  },
  "dependencies": {
    "@algorandfoundation/algokit-utils": "^9.1.1",
    "@algorandfoundation/algorand-typescript": "1.3.1",
    "@algorandfoundation/arc87": "*"
  },
  "devDependencies": {
    "@algorandfoundation/algorand-typescript-testing": "1.2.0",
    "@algorandfoundation/puya-ts": "1.3.1",
    "@faker-js/faker": "^9.9.0",
    "@rollup/plugin-typescript": "^12.1.4",
    "@types/node": "^24.0.14",
    "tslib": "^2.8.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.3"
  }
}
