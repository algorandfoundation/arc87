{
  "name": "arc-87-reference",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "ARC-87 reference workspace: conformance vectors + library, Algorand TypeScript and Algorand Python contracts",
  "license": "CC0-1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/algorandfoundation/arc-87-reference"
  },
  "workspaces": [
    "projects/conformance",
    "projects/arc-87-ts"
  ],
  "scripts": {
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present"
  },
  "devDependencies": {
    "@biomejs/biome": "2.1.1"
  },
  "overrides": {
    "@algorandfoundation/algorand-typescript": "1.3.1"
  }
}
